+
+
+def paths():
+    return {
+        code: {
+            **SPECIAL_STEEL_MEMBER_PATH,
+            "l3_code": code,
+            "industry_uid": SPECIAL_INDUSTRY_UID,
+            "identity_rule_version": IDENTITY_RULE_VERSION,
+        }
+        for code in IDENTITY_CANDIDATE_CODES
+    }
+
+
+def valuation(stock="000001.SZ"):
+    return {
+        "ts_code": stock,
+        "trade_date": DATES[-1],
+        "close": 10,
+        "pe": 10,
+        "pe_ttm": 10,
+        "pb": 1,
